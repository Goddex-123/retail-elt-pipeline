# ============================================================
# Retail ELT Platform — .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl

# ---- Virtual Environment ----
venv/
.venv/
env/
ENV/

# ---- Environment & Secrets ----
.env
*.pem
*.key

# ---- Airflow ----
logs/
airflow-webserver.pid
airflow-webserver.err
airflow-webserver.out
airflow-webserver.log
airflow.cfg
webserver_config.py
standalone_admin_password.txt

# ---- dbt ----
dbt_retail/target/
dbt_retail/dbt_packages/
dbt_retail/logs/
dbt_retail/.user.yml

# ---- Data Files ----
data/raw/*.csv
data/processed/
shared_data/
*.csv
!data/sample/*.csv

# ---- IDE ----
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---- OS Files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- Test / Coverage ----
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# ---- Docker ----
*.log
docker-compose.override.yml
