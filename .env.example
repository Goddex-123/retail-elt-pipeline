# ============================================================
# Retail ELT Platform — Environment Configuration
# ============================================================
# Copy this file to .env:  cp .env.example .env
# Then customize values as needed.
# NEVER commit the .env file to version control.
# ============================================================

# ---- PostgreSQL ----
# For local development/demo. Change for production.
POSTGRES_USER=retail_user
POSTGRES_PASSWORD=retail_pass_change_me
POSTGRES_DB=retail_warehouse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Airflow ----
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DEFAULT_TIMEZONE=Asia/Kolkata
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_change_me
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Generate a new Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# ---- dbt ----
DBT_PROFILES_DIR=/opt/airflow/dbt_retail
DBT_TARGET=dev

# ---- Pipeline Config ----
PIPELINE_LOG_LEVEL=INFO
PIPELINE_BATCH_SIZE=1000
PIPELINE_ENABLE_STREAMING=false

# ---- pgAdmin (optional) ----
PGADMIN_DEFAULT_EMAIL=admin@retail.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_change_me
